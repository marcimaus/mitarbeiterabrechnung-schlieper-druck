# Produktions-Build (vite build / Deploy): NIEMALS den lokalen Firestore-
# Emulator verwenden — auch dann nicht, wenn .env.local (Entwicklung)
# VITE_USE_EMULATOR=true setzt. Mode-spezifische Dateien (.env.production)
# haben in Vite Vorrang vor .env.local. Schützt davor, versehentlich ein
# Emulator-Bundle auf die Live-Seite zu deployen.
VITE_USE_EMULATOR=false
